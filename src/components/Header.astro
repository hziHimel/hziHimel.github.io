---
import Icon from './Icon.astro';
import { nav, profile } from '../data/site';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">HZ</span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="links" id="nav-links">
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  const btn = document.getElementById('menu-toggle');
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = header?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; gap: 1.5rem; height: 60px; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--text); flex-shrink: 0; }
  .mark {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 7px;
    background: var(--accent); color: var(--bg);
    font: 700 0.78rem/1 var(--font-serif); letter-spacing: 0.02em;
  }
  .brand-name { font: 600 1.02rem/1 var(--font-serif); }

  nav { margin-left: auto; }
  .links { display: flex; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .links a {
    display: block; padding: 0.4rem 0.65rem; border-radius: 6px;
    font-size: 0.9rem; color: var(--text-2); text-decoration: none;
  }
  .links a:hover { color: var(--text); background: var(--surface-2); }
  .links a[aria-current='page'] { color: var(--accent); font-weight: 600; }

  .actions { display: flex; gap: 0.25rem; }
  .icon-btn {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px;
    border: 1px solid transparent; background: transparent; color: var(--text-2); cursor: pointer;
  }
  .icon-btn:hover { background: var(--surface-2); color: var(--text); }
  .icon-btn :global(.i-sun), .icon-btn :global(.i-close) { display: none; }
  :global(:root[data-theme='dark']) .icon-btn :global(.i-sun) { display: block; }
  :global(:root[data-theme='dark']) .icon-btn :global(.i-moon) { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-btn :global(.i-sun) { display: block; }
    :global(:root:not([data-theme='light'])) .icon-btn :global(.i-moon) { display: none; }
  }
  .menu-btn { display: none; }

  @media (max-width: 900px) {
    .brand-name { font-size: 0.98rem; }
    nav { margin-left: auto; order: 3; }
    .actions { margin-left: auto; }
    .menu-btn { display: grid; }
    .links {
      display: none;
      position: absolute; left: 0; right: 0; top: 60px;
      flex-direction: column; gap: 0;
      background: var(--bg); border-bottom: 1px solid var(--rule);
      padding: 0.5rem 16px 1rem;
    }
    .links a { padding: 0.7rem 0.5rem; font-size: 1rem; }
    .site-header.open .links { display: flex; }
    .site-header.open .icon-btn :global(.i-open) { display: none; }
    .site-header.open .icon-btn :global(.i-close) { display: block; }
  }
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PubItem from '../components/PubItem.astro';
import portrait from '../assets/profile.jpg';
import { profile, links, interests, highlights, news } from '../data/site';
import { publications } from '../data/publications';
import { awards } from '../data/awards';
---
<Base>
  <section class="wrap hero">
    <aside class="id-card">
      <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[240, 480]} sizes="240px" class="portrait" loading="eager" />
      <div class="id-meta">
        <p class="aff">
          {profile.affiliation.map((a) => (
            <span><strong>{a.role}</strong><br /><a href={a.url}>{a.org}</a></span>
          ))}
        </p>
        <p class="loc"><Icon name="pin" size={15} /> {profile.location}</p>
        <ul class="profile-links">
          <li><a href={links.email}><Icon name="mail" /> {profile.email}</a></li>
          <li><a href={links.scholar}><Icon name="scholar" /> Google Scholar</a></li>
          <li><a href={links.github}><Icon name="github" /> GitHub</a></li>
          <li><a href={links.linkedin}><Icon name="linkedin" /> LinkedIn</a></li>
          <li><a href={links.cv}><Icon name="cv" /> Curriculum Vitae</a></li>
        </ul>
      </div>
    </aside>

    <div class="intro">
      <p class="eyebrow">{profile.title}</p>
      <h1>{profile.name} <span class="nick">({profile.nickname})</span></h1>
      <p class="lede">
        I build machine-learning systems that work in the real world, and I study why multimodal models
        sometimes only <em>look</em> like they work.
      </p>
      <div class="prose">
        <p>
          I am an M.Sc. student in Computer Science &amp; Engineering at
          <a href="https://www.ewubd.edu/">East West University</a> and an MLOps Engineer at
          <a href="https://www.grameenphone.com/">Grameenphone</a> (Telenor Group). My thesis examines
          <strong>multimodal fusion</strong>: when a fused model scores well, did every branch actually learn
          something useful, or is one quietly carrying the other? I approach the question through
          <strong>optimization dynamics</strong>, <strong>representation learning</strong>, and careful diagnostic
          evaluation, currently on biomedical audio.
        </p>
        <p>
          My path into this question ran through hardware. I trained as an electrical engineer at
          <a href="https://www.buet.ac.bd/">BUET</a>, built sensor-driven ML for livestock, and later deployed
          computer-vision systems at ACI Ltd., including Bangla license-plate recognition now running at
          35+ factory sites. I also worked as a graduate research assistant at FIU's ACyD Lab on adversarial
          attacks against distributed models on edge devices.
        </p>
      </div>
      <div class="callout">
        <Icon name="arrow" />
        <p>
          <strong>I am looking for PhD opportunities</strong> in machine learning, computer vision, multimodal
          learning, signal processing, or robotics. If my work overlaps with your group's, I would be glad to
          <a href={links.email}>hear from you</a>.
        </p>
      </div>
      <div class="cta">
        <a class="btn primary" href="/research/">Read about my research <Icon name="arrow" /></a>
        <a class="btn" href={links.cv}><Icon name="cv" /> Download CV</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="section reveal">
      <div class="stats">
        {highlights.map((h) => (
          <div class="stat"><span class="v">{h.value}</span><span class="l">{h.label}</span></div>
        ))}
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head"><h2>Research interests</h2></div>
      <ul class="chips">{interests.map((i) => <li class="chip">{i}</li>)}</ul>
    </section>

    <section class="section reveal two-col">
      <div>
        <div class="section-head"><h2>News</h2></div>
        <ul class="news">
          {news.map((n) => (
            <li><time>{n.date}</time><span set:html={n.text} /></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="section-head"><h2>Honors</h2></div>
        <ul class="awards">
          {awards.slice(0, 4).map((a) => (
            <li>
              <Icon name="trophy" size={16} />
              <div><strong>{a.title}</strong>{a.year && <span class="muted"> · {a.year}</span>}<br /><span class="muted">{a.note}</span></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head"><h2>Selected publications</h2><a href="/publications/">All publications →</a></div>
      {publications.map((p) => <PubItem pub={p} compact />)}
    </section>
  </div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 250px 1fr; gap: 3rem; padding-block: 3.25rem 2.5rem; align-items: start; }
  .id-card { position: sticky; top: 84px; }
  .portrait { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; border: 1px solid var(--rule); }
  .id-meta { margin-top: 1rem; font-size: 0.88rem; }
  .aff { display: grid; gap: 0.6rem; margin: 0 0 0.7rem; color: var(--text-2); line-height: 1.45; }
  .aff strong { color: var(--text); font-weight: 600; }
  .loc { display: flex; align-items: center; gap: 0.35rem; color: var(--muted); margin: 0 0 0.8rem; }
  .profile-links { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.15rem; border-top: 1px solid var(--rule); padding-top: 0.7rem; }
  .profile-links a { display: flex; align-items: center; gap: 0.55rem; padding: 0.3rem 0; color: var(--text-2); text-decoration: none; word-break: break-all; }
  .profile-links a:hover { color: var(--accent); }

  .nick { color: var(--muted); font-weight: 400; font-size: 0.7em; }
  .lede { font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.5; color: var(--text); margin-bottom: 1.4rem; }
  .prose { max-width: var(--measure); color: var(--text-2); }
  .prose strong { color: var(--text); font-weight: 600; }

  .callout {
    display: flex; gap: 0.75rem; align-items: flex-start;
    margin: 1.5rem 0; padding: 1rem 1.15rem; max-width: var(--measure);
    background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 var(--radius) var(--radius) 0;
  }
  .callout :global(svg) { color: var(--accent); flex-shrink: 0; margin-top: 4px; }
  .callout p { margin: 0; font-size: 0.95rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  .stat { background: var(--surface); padding: 1.2rem 1.25rem; display: grid; gap: 0.2rem; }
  .stat .v { font: 600 2rem/1.1 var(--font-serif); color: var(--accent); }
  .stat .l { font-size: 0.85rem; color: var(--text-2); line-height: 1.4; }

  .two-col { display: grid; grid-template-columns: 1.15fr 1fr; gap: 3rem; }
  .news, .awards { list-style: none; margin: 0; padding: 0; }
  .news li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem; padding: 0.55rem 0; font-size: 0.95rem; border-top: 1px dashed var(--rule); }
  .news li:first-child { border-top: 0; }
  .news time { font: 500 0.8rem/1.9 var(--font-mono); color: var(--muted); }
  .awards li { display: flex; gap: 0.7rem; padding: 0.55rem 0; font-size: 0.93rem; line-height: 1.5; }
  .awards :global(svg) { color: var(--accent); flex-shrink: 0; margin-top: 4px; }
  .awards strong { font-weight: 600; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 1.75rem; padding-top: 2rem; }
    .id-card { position: static; display: grid; grid-template-columns: 140px 1fr; gap: 1.25rem; align-items: start; }
    .id-meta { margin-top: 0; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .two-col { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 480px) {
    .id-card { grid-template-columns: 1fr; }
    .portrait { max-width: 180px; }
    .news li { grid-template-columns: 1fr; gap: 0; }
  }
</style>

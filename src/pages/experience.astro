---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { experience, earlier, education, skills } from '../data/experience';
import { links } from '../data/site';

// "1 yr 7 mos"-style duration, counting both the start and end months.
function duration(start: string, end?: string) {
  const [sy, sm] = start.split('-').map(Number);
  const now = new Date();
  const [ey, em] = end ? end.split('-').map(Number) : [now.getFullYear(), now.getMonth() + 1];
  const months = (ey - sy) * 12 + (em - sm) + 1;
  const y = Math.floor(months / 12), m = months % 12;
  return [y && `${y} yr${y > 1 ? 's' : ''}`, m && `${m} mo${m > 1 ? 's' : ''}`].filter(Boolean).join(' ');
}
const initials = (s: string) => s.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).slice(0, 2).map((w) => w[0]).join('');
---
<Base title="Experience" description="Industry and research experience, education, and skills of Hasan Zohirul Islam.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Experience</p>
      <h1>From sensors to production AI</h1>
      <p class="lede">
        More than five years of taking machine learning out of notebooks: embedded sensing, factory-floor
        computer vision, and telecom-scale MLOps.
      </p>
      <a class="btn" href={links.cv}><Icon name="cv" /> Full CV (PDF)</a>
    </header>

    <section class="section">
      <div class="section-head"><h2>Work &amp; research</h2></div>
      <ol class="timeline">
        {experience.map((r) => (
          <li class="reveal">
            <div class="node" aria-hidden="true">
              {r.logo ? <Image src={r.logo} alt="" width={96} height={96} class="logo" /> : <span class="mono">{initials(r.org)}</span>}
            </div>
            <div class="what">
              <div class="top">
                <div>
                  <h3>{r.role}</h3>
                  <p class="org">
                    {r.url ? <a href={r.url}>{r.org}</a> : r.org}
                    {r.orgNote && <span class="muted"> · {r.orgNote}</span>}
                  </p>
                </div>
                <div class="when">
                  <span class="period">{r.period}</span>
                  <span class="dur">{!r.end && <span class="now">Current · </span>}{duration(r.start, r.end)}</span>
                  <span class="muted">{r.location}</span>
                </div>
              </div>
              {r.summary && <p class="summary">{r.summary}</p>}
              <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
        {earlier.map((e) => (
          <li class="reveal small">
            <div class="node" aria-hidden="true"><span class="mono">{initials(e.org)}</span></div>
            <div class="what">
              <div class="top">
                <div>
                  <h3>{e.role}</h3>
                  <p class="org">{e.org}</p>
                </div>
                <div class="when"><span class="period">{e.period}</span></div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section reveal">
      <div class="section-head"><h2>Education</h2></div>
      <div class="edu">
        {education.map((e) => (
          <div class="card ed">
            <p class="period">{e.period}</p>
            <h3>{e.degree}</h3>
            <p class="school">{e.school}</p>
            <ul>{e.details.map((d) => <li>{d}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="section reveal">
      <div class="section-head"><h2>Skills</h2></div>
      <dl class="skills">
        {skills.map((s) => (
          <div><dt>{s.group}</dt><dd><ul class="chips">{s.items.map((i) => <li class="chip">{i}</li>)}</ul></dd></div>
        ))}
      </dl>
    </section>
  </div>
</Base>

<style>
  .page-head .btn { margin-top: 0.5rem; }
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline > li { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 1.5rem; padding-bottom: 2.25rem; }
  /* connecting line between nodes */
  .timeline > li::before {
    content: ''; position: absolute; left: 27px; top: 60px; bottom: 4px; width: 2px;
    background: linear-gradient(var(--rule), var(--rule)); border-radius: 2px;
  }
  .timeline > li:last-child::before { display: none; }
  .timeline > li:last-child { padding-bottom: 0; }
  .node {
    width: 56px; height: 56px; border-radius: 50%; background: #fff; border: 1px solid var(--rule);
    display: grid; place-items: center; overflow: hidden; box-shadow: var(--shadow); position: relative; z-index: 1;
  }
  .node :global(.logo) { width: 70%; height: 70%; object-fit: contain; }
  .mono { font: 600 0.95rem var(--font-serif); color: var(--accent); }
  .small .node { width: 40px; height: 40px; margin-left: 8px; background: var(--surface-2); }
  .small .mono { font-size: 0.78rem; }
  .small::before { left: 27px; top: 44px; }
  .small h3 { font-size: 1rem; }

  .top { display: flex; justify-content: space-between; gap: 1rem 2rem; align-items: flex-start; }
  .what h3 { margin-bottom: 0.15rem; }
  .org { margin: 0 0 0.5rem; font-weight: 500; }
  .when { display: grid; justify-items: end; gap: 0.1rem; font-size: 0.82rem; font-family: var(--font-mono); text-align: right; white-space: nowrap; }
  .period { color: var(--text); font-weight: 500; }
  .dur { color: var(--text-2); }
  .now { color: var(--ok); font-weight: 600; }
  .summary { color: var(--text-2); font-style: italic; font-family: var(--font-serif); margin: 0.25rem 0 0.5rem; }
  .what > ul { margin: 0; padding-left: 1.1rem; color: var(--text-2); font-size: 0.95rem; }
  .what li { margin-bottom: 0.3rem; }
  .what li::marker { color: var(--accent); }

  .edu { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .ed { padding: 1.4rem; }
  .period { font: 500 0.8rem var(--font-mono); color: var(--muted); margin: 0 0 0.4rem; }
  .ed h3 { margin-bottom: 0.2rem; }
  .school { margin: 0 0 0.6rem; color: var(--text-2); }
  .ed ul { margin: 0; padding-left: 1.1rem; font-size: 0.93rem; color: var(--text-2); }

  .skills { margin: 0; display: grid; gap: 1rem; }
  .skills > div { display: grid; grid-template-columns: 200px 1fr; gap: 2rem; align-items: baseline; }
  dt { font-weight: 600; font-size: 0.95rem; }
  dd { margin: 0; }

  @media (max-width: 760px) {
    .skills > div { grid-template-columns: 1fr; gap: 0.5rem; }
    .timeline > li { grid-template-columns: 44px 1fr; gap: 1rem; }
    .node { width: 44px; height: 44px; }
    .timeline > li::before { left: 21px; top: 48px; }
    .small .node { width: 32px; height: 32px; margin-left: 6px; }
    .small::before { left: 21px; }
    .top { flex-direction: column; gap: 0.35rem; }
    .when { display: flex; flex-wrap: wrap; gap: 0.15rem 0.9rem; text-align: left; white-space: normal; }
    .edu { grid-template-columns: 1fr; }
  }
</style>
